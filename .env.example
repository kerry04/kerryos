# KerryOS gateway - environment template.
# Copy to .env at this repo root and fill in every value.
# .env is gitignored. NEVER commit real secrets.
# Lines marked HUMAN_FILL need a human (or a setup script) to provide the value.

# --- Postgres (Guacamole DB) ---
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM

# --- Guacamole admin ---
# Default account is guacadmin; rotate with gateway/scripts/set-admin-password.sh
GUAC_ADMIN_USER=guacadmin
GUAC_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM

# --- Guacamole connection identifier for the single VNC session ---
# HUMAN_FILL: run gateway/scripts/create-connection.sh, then paste the printed identifier here.
GUAC_CONNECTION_ID=HUMAN_FILL_AFTER_CREATE_CONNECTION_SH

# --- Session broker ---
BROKER_ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM
SESSION_MAX_MINUTES=20
SESSION_IDLE_MINUTES=5

# --- Caddy / public site ---
# HUMAN_FILL: the public domain Caddy serves, e.g. kerryos.sokoresult.com
PORTFOLIO_DOMAIN=HUMAN_FILL
# HUMAN_FILL: email for Let's Encrypt ACME registration
ACME_EMAIL=HUMAN_FILL
# Public path prefix the Guacamole client is served under (must match the Caddyfile)
GUAC_PUBLIC_PATH=/guac

# Nothing below this line is real. Real values live only in .env on the host.
