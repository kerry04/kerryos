#!/bin/sh
#
# kerryos-start — pre-XFCE boot splash inside the guest.
#
# Win7-style: black frame, centered "Starting KerryOS" wordmark in the
# Aero-glow blue, and a phased progress bar (three segments that fill
# in sequence) while the XFCE session paints underneath.
#
# Constraints honored (verified in the noble image):
#   - xmessage does NOT exist in Ubuntu 24.04's x11-utils — dropped.
#   - No xdotool in the image; nothing here needs it. Geometry is painted
#     with stock tools only.
#   - GTK apps launched before xfwm4 have no window decorations and are
#     usually smaller than the VNC framebuffer; instead of fighting that,
#     the splash is a fullscreen X11 root-window pixmap (drawn with
#     `xsetroot` from x11-utils, which IS in the image) plus a zenity-styled
#     label bar if zenity exists. Everything fails soft: a missing tool at
#     any step means "skip that visual, still boot XFCE".
#
# Runs as the `visitor` user from guest/entrypoint.sh section 6b, after
# Xvnc :1 is up and startxfce4 has been launched in the background. It
# draws its frame over the first ~3s of XFCE painting, then exits so the
# real desktop shows through.
set -u

DISPLAY="${DISPLAY:-:1}"
export DISPLAY

PPI="$PWD"           # scratch dir inside tmpfs for generated PNGs
BG="#0a1428"
FG="#9fd3ff"
ACCENT="#2b9bf3"

command -v xsetroot >/dev/null 2>&1 || exit 0
command -v convert   >/dev/null 2>&1 || SPLASH_CAN_DRAW=0

# ---------------------------------------------------------------------
# Phase A: solid boot-navy backdrop the moment XFCE's own desktop appears.
# (Also masks any white flash before xfdesktop paints the wallpaper.)
# ---------------------------------------------------------------------
xsetroot -solid "$BG" 2>/dev/null || true

# ---------------------------------------------------------------------
# Phase B: phased progress bar, once per step, painted via ImageMagick
# into a root-window pixmap (convert exists in the image since it is how
# wallpaper.png is generated at build time).
# ---------------------------------------------------------------------
if [ "${SPLASH_CAN_DRAW:-1}" = "1" ]; then
  W=1280; H=800
  icon_test="$PPI/splash.png"
  # Build the splash image: navy bg + centered wordmark + progress bar.
  # Fonts: DejaVu Sans is in the image (fonts-dejavu-core).
  draw_splash() {
    fill_pct="$1"
    convert -size ${W}x${H} xc:"$BG" \
      -font DejaVu-Sans -pointsize 42 -fill "$FG" \
      -gravity center -annotate +0-60 "Starting KerryOS" \
      -pointsize 16 -fill '#5a7089' -gravity center \
      -annotate +0+40 "a real disposable Linux desktop — 20 minutes" \
      -stroke "$ACCENT" -strokewidth 2 -fill none \
      -draw "rectangle 480,560 800,572" \
      -fill "$ACCENT" -stroke none \
      -draw "rectangle 482,562 800,570" \
      -draw "rectangle 482,562 $((482 + (318 * fill_pct) / 100)),570" \
      "$icon_test" 2>/dev/null
    xsetroot -center "$icon_test" 2>/dev/null || xsetroot "$icon_test" 2>/dev/null || true
  }
  draw_splash 20  & sleep 1.0
  draw_splash 55  & sleep 1.0
  draw_splash 85  & sleep 0.5
  draw_splash 100 & sleep 0.5
  LWAIT=$!
  # Give the progress bar at most 3.4s, no matter what.
  wait $LWAIT 2>/dev/null || true
else
  sleep 3
fi

# ---------------------------------------------------------------------
# Phase C: reveal. xfdesktop owns the root window from here on; the
# wallpaper override it applies replaces our overlay within a repaint.
# If the wallpaper was slow to appear this still hands off cleanly.
# ---------------------------------------------------------------------
[ -f "$icon_test" ] && rm -f "$icon_test" 2>/dev/null
exit 0
