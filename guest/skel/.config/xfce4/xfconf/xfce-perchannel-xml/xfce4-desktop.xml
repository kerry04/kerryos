<?xml version="1.0" encoding="UTF-8"?>

<channel name="xfce4-desktop" version="1.0">
  <property name="desktop-icons" type="empty">
    <!-- Show ~/Desktop file/launcher icons on the desktop. -->
    <property name="icon-style" type="uint" value="2"/>
    <property name="file-icons" type="empty">
      <property name="show-home" type="bool" value="false"/>
      <property name="show-filesystem" type="bool" value="false"/>
      <property name="show-trash" type="bool" value="false"/>
      <property name="show-removable" type="bool" value="false"/>
    </property>
  </property>
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <!-- Covers every monitor name seen under Xvnc (VNC-0 and VNC-1 both
           observed live 2026-10-11). Phase 3: last-image is the Win7-style
           gradient wallpaper shipped at /opt/kerryos/wallpaper.png;
           image-style 3 = scaled-to-fill. -->
      <property name="monitorVNC-0" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="3"/>
          <property name="last-image" type="string" value="/opt/kerryos/wallpaper.png"/>
        </property>
      </property>
      <property name="monitorVNC-1" type="empty">
        <property name="workspace0" type="empty">
          <property name="color-style" type="int" value="0"/>
          <property name="image-style" type="int" value="3"/>
          <property name="last-image" type="string" value="/opt/kerryos/wallpaper.png"/>
          <property name="color1" type="array">
            <value type="int" value="8224"/>
            <value type="int" value="22102"/>
            <value type="int" value="43176"/>
            <value type="int" value="65535"/>
          </property>
        </property>
      </property>
    </property>
  </property>
</channel>
