# KerryOS gateway - Guacamole client configuration (template)
#
# Guacamole resolves ${VAR} references in this file from the container
# environment (see assumptions in the task report - verify on brain 67).
# Mounted read-only into the guacamole service.

guacd-hostname: guacd
guacd-port: 4822

postgresql-hostname: postgres
postgresql-port: 5432
postgresql-database: guacamole_db
postgresql-username: guacamole_user
postgresql-password: ${POSTGRES_PASSWORD}
