# KerryOS gateway - Caddy reverse proxy (template)
#
# HUMAN_FILL: set PORTFOLIO_DOMAIN and ACME_EMAIL in the repo-root .env,
# then reload caddy. The root "/" handler is a placeholder; the portfolio
# team merges their real site here in Phase 3.

{
	email {$ACME_EMAIL}
}

{$PORTFOLIO_DOMAIN} {

	encode gzip

	# Session broker API (keeps its own /api prefix)
	handle /api/* {
		reverse_proxy broker:8080
	}

	# Guacamole client under /guac (matches GUAC_PUBLIC_PATH=/guac)
	handle /guac {
		redir /guac/ 302
	}
	# Guacamole serves from its /guacamole context path; map /guac/* onto it.
	# (strip_prefix alone would 404, because the app is not at the container root.)
	handle /guac/* {
		uri replace /guac/ /guacamole/
		reverse_proxy guacamole:8080
	}

	# Phase 3: the KerryOS front door. The frontend-snippet page boots a
	# session via same-origin /api/*, plays the Win7 boot overlay, then embeds
	# the Guacamole client in an iframe pointed at /guac/.
	handle_path /kerryos-frontend/* {
		root * /srv/kerryos-frontend
		try_files {path} /index.html
		file_server
	}

	# Root placeholder still serves the banner until the domain routes here
	# on purpose (the portfolio site may keep its own landing at /).
	handle {
		respond "KerryOS gateway is up." 200
	}
}
